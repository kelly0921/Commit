[Unit]
Description=Commit staging consumer and durable coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=commit-staging
Group=commit-staging
WorkingDirectory=/opt/commit-staging/app
EnvironmentFile=/etc/commit-staging/runtime.env
Environment=PRODUCT_PORT=3010
Environment=BIND_ADDRESS=127.0.0.1
Environment=COMMIT_STAGING=true
Environment=PRODUCT_DATABASE_PATH=/var/lib/commit-staging/staging.sqlite
ExecStart=/usr/bin/node dist/src/product/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/commit-staging

[Install]
WantedBy=multi-user.target
