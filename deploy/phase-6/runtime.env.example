# Install as /etc/commit-staging/runtime.env, root-owned 0600. Never commit filled values.
PUBLIC_CONSUMER_ORIGIN=https://consumer.your-domain.example
PUBLIC_MERCHANT_ORIGIN=https://merchant.your-domain.example
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_MODE=openai
AG_STUDIO_LICENSE_KEY=
ENABLE_SANDBOX_SAGA_NEGATIVE_TEST=false
WEB_PUSH_CONTACT=mailto:operations@your-domain.example
# configure-staging.mjs generates the two keys directly into this file.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
