PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Optional extra routing check: configured Sandbox business account's merchant ID.
PAYPAL_MERCHANT_ID=
# Optional public client ID. Must equal PAYPAL_CLIENT_ID; this is not a Next.js app.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PORT=3000

# Product foundation runs separately from the verified PayPal harness.
PRODUCT_PORT=3002
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Explicit limited local demo only. Provider errors never trigger a fallback.
AI_MODE=openai

# Optional local Sandbox acceptance only; fixed capture-3 mock, default disabled.
ENABLE_SANDBOX_SAGA_NEGATIVE_TEST=false

# Isolated read-only merchant origin; reuses OPENAI_API_KEY and OPENAI_MODEL above.
MERCHANT_PORT=3005
# Optional official AG Studio evaluation license. Keep actual key in ignored .env.
AG_STUDIO_LICENSE_KEY=

# Consumer PWA delivery. Only this public VAPID key enters the consumer browser.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=
# Optional exact HTTPS origins behind a trusted TLS reverse proxy.
PUBLIC_CONSUMER_ORIGIN=
PUBLIC_MERCHANT_ORIGIN=
# Default loopback; use 0.0.0.0 only in a protected staging/container environment.
BIND_ADDRESS=127.0.0.1
# Use an isolated database when evaluating Phase 6; preserve historical evidence.
PRODUCT_DATABASE_PATH=data/phase-6-local.sqlite
